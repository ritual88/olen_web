---
import Base from '../layouts/Base.astro';
import { site, servicesPage, services } from '../data/site';
---

<Base title={`${servicesPage.title} — ${site.name}`} description={servicesPage.lead}>
  <section class="container page">
    <div class="eyebrow">{servicesPage.eyebrow}</div>
    <h1 class="page__title">{servicesPage.title}</h1>
    <p class="page__lead">{servicesPage.lead}</p>

    {
      services.map((service) => (
        <div class="service" id={service.id}>
          <div>
            <h2 class="service__title">{service.title}</h2>
            {service.short && <p class="service__text">{service.short}</p>}
            <p class="service__meta">Что нужно от вас: {service.need}</p>
            <div class="hero__actions">
              <a class="btn btn--primary" href={site.telegram} target="_blank" rel="noopener noreferrer">
                {service.cta}
              </a>
            </div>
          </div>
          <div>
            <ul class="service__list">
              {service.includes.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      ))
    }
  </section>

  <section class="container section">
    <div class="section__head">
      <span class="section__idx">{servicesPage.price.idx}</span>
      <h2 class="section__label">{servicesPage.price.label}</h2>
    </div>

    <div class="prose" style="margin-top: var(--space-6)">
      <p>{servicesPage.price.p1}</p>
      <p>{servicesPage.price.p2}</p>
      <ul>
        {servicesPage.price.bullets.map((item) => <li>{item}</li>)}
      </ul>
      <p>{servicesPage.price.p3}</p>
    </div>
  </section>
</Base>
