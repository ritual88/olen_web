---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const base = Astro.site ?? new URL('https://example.com');
const abs = (path: string) => new URL(path, base).href;
const canonical = abs(Astro.url.pathname);
const ogImage = abs('/img/og.jpg');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': abs('/#person'),
      name: site.name,
      jobTitle: 'Веб-дизайнер и разработчик',
      url: abs('/'),
      email: `mailto:${site.email}`,
      telephone: site.phone,
      sameAs: [site.telegram]
    },
    {
      '@type': 'ProfessionalService',
      '@id': abs('/#business'),
      name: `${site.name} — сайты`,
      url: abs('/'),
      image: ogImage,
      description: 'Дизайн и разработка сайтов под ключ: структура, макет, вёрстка, запуск.',
      founder: { '@id': abs('/#person') },
      email: site.email,
      telephone: site.phone,
      sameAs: [site.telegram],
      serviceType: ['Разработка сайтов', 'Веб-дизайн']
    }
  ]
};

const jsonLdSafe = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#EFEBE2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <link rel="preload" href="/fonts/plex-mono-400-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={jsonLdSafe} />
  </head>
  <body>
    <div class="bg-type" aria-hidden="true">


      <span class="bg-type__blur bg-type__blur--1">Структура. Макет. Запуск.</span>
      <span class="bg-type__blur bg-type__blur--2">Сначала структура, потом дизайн, потом код.</span>
    </div>

    <a class="skip-link" href="#main">К содержанию</a>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline src="/js/reveal.js" defer></script>
    <script is:inline src="/js/metrika.js" defer></script>
    <noscript>
      <img src="https://mc.yandex.ru/watch/114347402" style="position:absolute;left:-9999px" alt="" />
    </noscript>
  </body>
</html>
